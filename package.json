{
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "name": "confsys",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24.21.0 <25",
    "pnpm": ">=10.34.7 <11"
  },
  "scripts": {
    "infra:up": "node --conditions=development --import tsx scripts/compose.mjs up -d --wait postgres redis mailpit",
    "infra:down": "node --conditions=development --import tsx scripts/compose.mjs down",
    "dev": "pnpm --filter @confsys/web build:public && concurrently -k -n api,worker,web \"pnpm dev:api\" \"pnpm dev:worker\" \"pnpm dev:web\"",
    "dev:api": "node --env-file=${CONFSYS_ENV_FILE:-.env} --conditions=development --import tsx scripts/run-process.ts api dev",
    "dev:worker": "node --env-file=${CONFSYS_ENV_FILE:-.env} --conditions=development --import tsx scripts/run-process.ts worker dev",
    "dev:web": "node --env-file=${CONFSYS_ENV_FILE:-.env} apps/web/node_modules/vite/bin/vite.js --host 127.0.0.1 --config apps/web/vite.config.ts apps/web",
    "db:migrate": "node --conditions=development --env-file=${CONFSYS_ENV_FILE:-.env} --import tsx packages/db/src/migrate.ts",
    "lint": "eslint . && node scripts/check-boundaries.mjs",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run tests/unit",
    "test:integration": "node --env-file=${CONFSYS_ENV_FILE:-.env} node_modules/vitest/vitest.mjs run tests/integration",
    "test:contract": "vitest run tests/contract",
    "contract:generate": "tsx --conditions=development scripts/openapi.ts",
    "test:e2e": "node --env-file=${CONFSYS_ENV_FILE:-.env} node_modules/@playwright/test/cli.js test",
    "build": "node scripts/clean-build.mjs && tsc -p tsconfig.build.json && node scripts/distribute-build.mjs && pnpm --filter @confsys/web build",
    "check": "pnpm lint && pnpm typecheck && pnpm test:unit && pnpm test:integration && pnpm test:contract && pnpm build && pnpm test:e2e",
    "env:setup": "node --conditions=development --import tsx scripts/setup.mjs",
    "smoke:stack": "node --conditions=development --env-file=${CONFSYS_ENV_FILE:-.env} --import tsx scripts/smoke-stack.ts",
    "db:migrate:test": "node --env-file=${CONFSYS_ENV_FILE:-.env} --conditions=development --import tsx scripts/migrate-test.ts",
    "smoke:auth": "node --conditions=development --env-file=${CONFSYS_ENV_FILE:-.env} --import tsx scripts/smoke-auth.ts",
    "compose": "node --conditions=development --import tsx scripts/compose.mjs",
    "test:demo:https": "node scripts/test-https-demo.mjs",
    "test:instances": "node --conditions=development --import tsx scripts/test-instances.ts",
    "admin:bootstrap": "node --conditions=development --env-file=${CONFSYS_ENV_FILE:-.env} --import tsx scripts/bootstrap-admin.ts",
    "test:access": "node --env-file=${CONFSYS_ENV_FILE:-.env} node_modules/vitest/vitest.mjs run tests/integration/access.test.ts",
    "test:site": "node --env-file=${CONFSYS_ENV_FILE:-.env} node_modules/vitest/vitest.mjs run tests/integration/site.test.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "bullmq": "6.3.15",
    "concurrently": "10.0.6",
    "drizzle-orm": "0.45.4",
    "eslint": "10.12.0",
    "ioredis": "5.11.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  },
  "dependencies": {
    "@confsys/config": "workspace:*",
    "@confsys/contracts": "workspace:*",
    "@confsys/db": "workspace:*",
    "@confsys/notifications": "workspace:*",
    "@confsys/sdk": "workspace:*"
  }
}
