# Run pnpm env:setup; it generates .env with random local credentials.
# This file documents names only; placeholders are intentionally not usable secrets.
POSTGRES_PASSWORD=<generated>
MIGRATOR_PASSWORD=<generated>
APP_PASSWORD=<generated>
WORKER_PASSWORD=<generated>
MIGRATION_DATABASE_URL=postgresql://confsys_migrator:<generated>@127.0.0.1:25432/confsys
DATABASE_URL=postgresql://confsys_app:<generated>@127.0.0.1:25432/confsys
WORKER_DATABASE_URL=postgresql://confsys_worker:<generated>@127.0.0.1:25432/confsys
TEST_MIGRATION_DATABASE_URL=postgresql://confsys_migrator:<generated>@127.0.0.1:25432/confsys_test
TEST_DATABASE_URL=postgresql://confsys_app:<generated>@127.0.0.1:25432/confsys_test
TEST_WORKER_DATABASE_URL=postgresql://confsys_worker:<generated>@127.0.0.1:25432/confsys_test
REDIS_URL=redis://127.0.0.1:26379/0
TEST_REDIS_URL=redis://127.0.0.1:26379/1
WORKER_HEALTH_URL=http://127.0.0.1:23001
NODE_ENV=development
API_PORT=23000
WORKER_PORT=23001
# SMTP is restricted to local Mailpit. No external provider or payment credentials.
PUBLIC_APP_ORIGIN=http://127.0.0.1:25173
CSRF_SIGNING_KEY=<generated 32-byte hex>
MAIL_KEY_VERSION=v1
MAIL_ENCRYPTION_KEY=<generated 32-byte hex>
SMTP_HOST=127.0.0.1
SMTP_PORT=21025
SESSION_IDLE_SECONDS=1800
SESSION_ABSOLUTE_SECONDS=43200
VERIFICATION_TTL_SECONDS=86400
RESET_TTL_SECONDS=1800
